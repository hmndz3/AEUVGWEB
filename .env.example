# ============================================================
# Variables de entorno - Página web AEUVG
# ============================================================
# Copiar este archivo como .env y completar los valores.
# El archivo .env NUNCA se sube al repositorio (está en .gitignore).
# En Railway, estas variables se configuran desde el panel del
# servicio (pestaña Variables), por ambiente (pruebas y producción).
# ============================================================

# --- Base de datos (PostgreSQL) ---
# Local (docker compose): postgresql://aeuvg:aeuvg_dev@localhost:5432/aeuvg
# Railway: usar la referencia ${{Postgres.DATABASE_URL}}
DATABASE_URL="postgresql://aeuvg:aeuvg_dev@localhost:5432/aeuvg"

# --- Aplicación ---
# URL pública de la aplicación (cambia según el ambiente)
# Pruebas:    https://aeuvg-pruebas.up.railway.app
# Producción: https://aeuvg.uvg.gt (cuando el dominio esté configurado)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Dominio institucional permitido para cuentas de estudiantes, sin arroba.
INSTITUTIONAL_EMAIL_DOMAIN="uvg.edu.gt"

# --- Autenticación ---
# Secreto para firmar sesiones. Generar con: openssl rand -base64 32
# Debe ser DIFERENTE en pruebas y en producción.
AUTH_SECRET=""

# Vigencia y límites de los enlaces de verificación de correo.
EMAIL_VERIFICATION_TOKEN_TTL_MINUTES="30"
EMAIL_VERIFICATION_RESEND_COOLDOWN_SECONDS="60"
EMAIL_VERIFICATION_RESEND_MAX_PER_HOUR="5"

# --- Correo transaccional ---
# En desarrollo se usa "memory": permite probar el flujo sin enviar ni escribir
# datos sensibles en logs o disco. Para envíos reales usar "resend" y configurar la clave y un
# remitente de un dominio previamente verificado en Resend.
EMAIL_PROVIDER="memory"
RESEND_API_KEY=""
EMAIL_FROM="AEUVG <noreply@aeuvg.uvg.gt>"
